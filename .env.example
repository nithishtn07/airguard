# ==========================================
# AIRGUARD AI - Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Configuration (Default: SQLite local database)
DATABASE_URL=sqlite:///./data/airguard.db

# External API Keys (Phase 2 - Real-Time Data Collection)
# Note: Open-Meteo works out of the box without keys.
# Provide keys below only if configuring alternate providers.
AIR_QUALITY_API_KEY=
WEATHER_API_KEY=
GEMINI_API_KEY=

# API Request & Caching Controls
EXTERNAL_API_TIMEOUT_SECONDS=10.0
CACHE_TTL_SECONDS=60

# Security & CORS Settings
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]

# Phase 4 - Machine Learning Configuration
MIN_TRAINING_ROWS=30
MODELS_DIR=./ml/models
DEFAULT_MODEL_TYPE=RandomForestRegressor
RANDOM_SEED=42

# Phase 5 - Pollution Hotspots & Anomaly Detection
ANOMALY_METHOD=zscore
ANOMALY_Z_THRESHOLD=2.5
ANOMALY_ROLLING_WINDOW=24
MIN_ANOMALY_OBSERVATIONS=12
HOTSPOT_SCORE_THRESHOLD=0.60
HOTSPOT_HISTORY_HOURS=24
MIN_HOTSPOT_OBSERVATIONS=6

# Phase 6 - Risk Assessment, Smart Recommendations & Intelligent Alerts
RISK_MODEL=composite_v1
RISK_LOW_MAX=25.0
RISK_MODERATE_MAX=50.0
RISK_HIGH_MAX=75.0
RISK_VERY_HIGH_MAX=90.0
ALERT_COOLDOWN_MINUTES=60
ALERT_DEDUPLICATION_ENABLED=True
HIGH_RISK_ALERT_ENABLED=True
ANOMALY_ALERT_ENABLED=True
HOTSPOT_ALERT_ENABLED=True
PREDICTION_ALERT_ENABLED=True

# Phase 9 - User-Selected Location & Custom Time-Window Analysis
GEOCODING_API_KEY=
GEOCODING_PROVIDER=openmeteo_nominatim
MAX_CUSTOM_RANGE_DAYS=365


